{
  "schema_version": "0.4",
  "status": "frozen_pilot",
  "description": "Constrained vocab for Stage 6 runbook tags and Stage 5 playbook expects_* fields. Same capability + different access_surface is valid multi-link. Deep surface catalogs live under docs/ontology/catalogs/ (reference-only, not expects_* IDs).",
  "source_notes": [
    "Seeded from docs/ontology/support_roles_components_and_adjacency.md \u00a75",
    "Surfaces aligned with stage_prompts/shared/role_component_access_matrix.md",
    "operator = customer/client site (not FORTNA); L1/L2/L3/L4 = FORTNA remote",
    "A0 completeness: Day 2 VTT + Active AGV SQL guide + OptiSweep Training Slides [INTERNAL ONLY].pdf (authoritative PascalCase models/APIs/services)",
    "0.4: catalogs externalized to docs/ontology/catalogs/; added capability_failure_edges + surface_activities; Day2 OCR/transcript field semantics for WCS SQL"
  ],
  "capabilities": [
    {
      "id": "agv_active_errors",
      "label": "AGV active errors",
      "description": "Confirm whether AGVs/robots have active error or fault state (RMS and/or WCS AGV Active Error / SystemActiveErrorModel)."
    },
    {
      "id": "device_roster_state",
      "label": "Device roster / map state",
      "description": "Confirm robot roster, mapping, locations, cell codes, or abnormal fleet membership (RMS and/or Robotics robot / robot-location / cell-code models)."
    },
    {
      "id": "fleet_system_status",
      "label": "Fleet / overall system status",
      "description": "Confirm overall RMS/system-down or fleet overview health."
    },
    {
      "id": "sort_lifecycle_state",
      "label": "Sort lifecycle / system state",
      "description": "Confirm WCS system/sort state and sort GUID (startup, running, shutdown, zone-config, closeout staging) via system state model or equivalent UI."
    },
    {
      "id": "hospital_diversion",
      "label": "Hospital diversion / lane routing",
      "description": "Confirm hospital lane diversion, stacklight, hospital model queues, or hospital workflow routing."
    },
    {
      "id": "zone_pairing_state",
      "label": "Zone pairing state",
      "description": "Confirm whether a zone can obtain a pair / normal pairing behavior."
    },
    {
      "id": "zone_config_state",
      "label": "Zone configuration state",
      "description": "Confirm current zone configuration (Get/Update Zone Config) or zone-config staging/closeout progress."
    },
    {
      "id": "tipper_station_fault",
      "label": "Tipper / operator station fault",
      "description": "Confirm tipper, VISU/WebVisu, tipper/tipper-station DB models, or operator-station fault indications."
    },
    {
      "id": "e_stop_or_safety_stop",
      "label": "E-stop / safety stop",
      "description": "Confirm physical E-stop or safety-stop state (site/operator for physical E-stop; WCS ESTOP model may corroborate Geek callbacks)."
    },
    {
      "id": "rms_soft_stop",
      "label": "RMS soft stop (pause)",
      "description": "Apply or confirm RMS pause/soft stop or PauseAGVs/ResumeAGVs \u2014 L2/L3 only; not physical E-stop."
    },
    {
      "id": "gateway_health",
      "label": "Ignition gateway health",
      "description": "Confirm Ignition gateway health, Systems Overview / performance, memory, or OPC connection page reachability."
    },
    {
      "id": "wcs_service_health",
      "label": "WCS / OptiSweep service health",
      "description": "Confirm OptiSweep Windows service and host trio with Ignition/Stunnel; SQL Server connectivity / SQL Agent on backup as needed (unplanned restart)."
    },
    {
      "id": "wcs_api_responsiveness",
      "label": "WCS / OptiSweep API responsiveness",
      "description": "Confirm API calls such as GetAgvStatuses or related WCS API health."
    },
    {
      "id": "windows_service_or_event_log",
      "label": "Windows services / Event Viewer",
      "description": "Confirm service state or Application/System log errors."
    },
    {
      "id": "agv_physical_recovery",
      "label": "AGV physical recovery / removal",
      "description": "On-site remove/add AGV, bump recovery, or isolation from active fleet."
    },
    {
      "id": "robot_dwell_or_shutdown_staging",
      "label": "Robot dwell / shutdown staging",
      "description": "Confirm Location Active Dwell, shutdown staging queues/sequence, or related Robotics DB state (Day 2 SSMS)."
    },
    {
      "id": "agv_charging_state",
      "label": "AGV charging state",
      "description": "Confirm charging areas, charger locations, charging thresholds, or charge-related robot state (Day 2 SSMS / RMS)."
    },
    {
      "id": "sorter_item_or_scan_state",
      "label": "Sorter item / scan state",
      "description": "Confirm SorterSweeper Items model, scan data, lane activity, cube/default dimensions, or related DB/UI state."
    },
    {
      "id": "tote_exchange_sequence",
      "label": "Tote exchange sequence",
      "description": "Confirm tote exchange sequence, ActiveExchangeModel, exchange settings (cube/count/weight thresholds), or hot-bin / missort / purge exchange types."
    },
    {
      "id": "bag_out_or_closeout_state",
      "label": "Bag-out / closeout state",
      "description": "Confirm active bag-out / chute closeout progress vs stuck (active bag-out model; sort closeout path)."
    },
    {
      "id": "robot_command_or_task_state",
      "label": "Robot command / task state",
      "description": "Confirm Robotics robot-command / robot-task (and SorterSweeper task) status toward Geek Plus \u2014 stuck, active, or archive."
    },
    {
      "id": "wcs_system_faults",
      "label": "WCS system faults",
      "description": "Confirm WCS system faults / System Active Error (software-level) beyond per-AGV active errors alone."
    },
    {
      "id": "lane_or_chute_state",
      "label": "Lane / chute state",
      "description": "Confirm sorter lane/chute status (Active/Bypassed/NotTracking), KeepClose, OpenAllChutes, or related Aveva/API/DB state."
    },
    {
      "id": "tote_lifecycle_state",
      "label": "Tote lifecycle / inventory state",
      "description": "Confirm tote initialize/remove, Tote Model status/errors (NoRead, MissMatch, AgvRemoved), or GetToteTask inventory."
    },
    {
      "id": "ups_chat_or_stunnel_health",
      "label": "UPS Chat / Stunnel health",
      "description": "Confirm S-Tunnel connections (AI01/AI02/SortationChat) and Chat xLE path between OTNet and UPS."
    },
    {
      "id": "opc_connection_or_tipper_heartbeat",
      "label": "OPC connection / tipper heartbeat",
      "description": "Confirm Ignition OPC Connections to tippers/hospital and tipper WebVisu heartbeat (unplanned-restart path)."
    }
  ],
