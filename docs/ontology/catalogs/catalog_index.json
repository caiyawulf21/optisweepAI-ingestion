{
  "schema_version": "0.4",
  "description": "Index of machine-retrievable system documentation catalogs for Stage 6 mini-RAG. All access-surface catalogs share surface_catalog_schema.json (aliases, when_to_use, activities, objects, evidence, \u2026).",
  "layout": {
    "taxonomy": "docs/ontology/taxonomy/runbook_capability_taxonomy.json",
    "catalogs": "docs/ontology/catalogs/",
    "sources_future": "docs/ontology/sources/{day1,day2,om_manual}/",
    "adjacency": "docs/ontology/support_roles_components_and_adjacency.md"
  },
  "retrieval": {
    "helper": "shared_pipeline_stages/ontology_rag.py",
    "stage5": {
      "max_snippets": 2,
      "snippet_budget_chars": 800,
      "prefer": [
        "surface",
        "capability"
      ],
      "packet_field": "ontology_snippets"
    },
    "stage6": {
      "max_snippets": 3,
      "snippet_budget_chars": 1200,
      "prefer": [
        "model",
        "capability",
        "activity",
        "surface"
      ],
      "packet_field": "ontology_snippets"
    },
    "keys": [
      "capability",
      "access_surface",
      "model_name",
      "database_id",
      "failure_pattern",
      "activity_id",
      "free_text"
    ]
  },
  "catalogs": {
    "capabilities": "docs/ontology/catalogs/capability_catalog.json",
    "wcs_sql": "docs/ontology/catalogs/wcs_sql_catalog.json",
    "wcs_api": "docs/ontology/catalogs/wcs_api_catalog.json",
    "rms_ui": "docs/ontology/catalogs/rms_ui_catalog.json",
    "ignition_gateway": "docs/ontology/catalogs/ignition_gateway_catalog.json",
    "stunnel": "docs/ontology/catalogs/stunnel_catalog.json",
    "event_viewer": "docs/ontology/catalogs/event_viewer_catalog.json",
    "apidog": "docs/ontology/catalogs/apidog_catalog.json",
    "aveva_hmi": "docs/ontology/catalogs/aveva_hmi_catalog.json",
    "tipper_hmi": "docs/ontology/catalogs/tipper_hmi_catalog.json",
    "hospital_hmi": "docs/ontology/catalogs/hospital_hmi_catalog.json",
    "edges": "docs/ontology/catalogs/cross_links.json",
    "index": "docs/ontology/catalogs/catalog_index.json",
    "building_acb_hmi": "docs/ontology/catalogs/building_acb_hmi_catalog.json",
    "site_interview": "docs/ontology/catalogs/site_interview_catalog.json",
    "physical_floor": "docs/ontology/catalogs/physical_floor_catalog.json",
    "schema": "docs/ontology/catalogs/surface_catalog_schema.json"
  },
  "provenance_contract": {
    "evidence": [
      "source",
      "kind",
      "snippet"
    ],
    "needs_sme": "set when meaning unknown \u2014 do not invent",
    "source_refs": "training_video_day1|day2|slides|active_agv_error_query_1|om_manual|adjacency"
  },
  "surface_catalog_schema": "docs/ontology/catalogs/surface_catalog_schema.json"
}
