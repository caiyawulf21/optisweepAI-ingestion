# =============================================================================
# OptiSweep AI Ingestion — AGENT ENV MOCK (no real secrets)
# =============================================================================
# PURPOSE
#   Machine- and agent-readable inventory of every environment variable this
#   repo reads to run operational + incidence ingestion, shared stages 6.5–11,
#   Brain storage, MCP providers, and optional SharePoint/Graph/Salesforce
#   probes. Copy to `.env` and replace every `<...>` / empty value with real
#   secrets. NEVER commit a filled `.env`.
#
# HOW AN AGENT SHOULD USE THIS FILE
#   1. Treat KEYS marked [REQUIRED] as hard blockers for that capability.
#   2. Prefer the primary key name; aliases are listed under "Also accepted".
#   3. Do not invent new env var names — extend this file + `.env.example`
#      if code gains a new getenv.
#   4. Values below are FAKE placeholders only (look like real shapes).
#   5. After filling `.env`, smoke-check with the scripts named in each block.
#
# RELATED FILES
#   .env.example                         — shorter human template (same keys)
#   app_handoff_package/config/feature_flags.env.example
#                                        — Phase 0 APP runtime (not ingestion)
#   AGENT_AZURE_HANDOFF.md               — Azure bootstrap / handoff steps
#   HANDOFF_DATA_INVENTORY.md            — local pipeline data trees
#   LOCAL_PIPELINE_DATA.zip              — full local stage/Brain data archive
#
# LOAD ORDER
#   Most stages call python-dotenv `load_dotenv()` from the repo root `.env`.
# =============================================================================


# -----------------------------------------------------------------------------
# BLOCK A — Chat LLM (operational + incidence Stages 3–7; shared Stage 7/8)
# Consumers: providers/azure_openai_llm.py, operationalknowledgeingestion
#            stage3–6, incidenceknowledgeingestion stage3–6,
#            shared_pipeline_stages/stage_7/merge_runner.py,
#            shared_pipeline_stages/stage_8/linking_runner.py
# Smoke: any stage that calls the chat client; prefer gpt-mini over DeepSeek
#        for rate limits.
# -----------------------------------------------------------------------------
# Endpoint shapes (auto-detected by shared_pipeline_stages/llm_pacing.py):
#   classic:      https://<resource>.openai.azure.com
#                 AZURE_OPENAI_API_VERSION = dated, e.g. 2024-10-21
#   Foundry proj: https://<resource>.services.ai.azure.com/api/projects/<proj>
#                 AZURE_OPENAI_API_VERSION = dated, e.g. 2025-04-01-preview
#   Foundry v1:   https://<resource>.services.ai.azure.com/openai/v1/responses
#                 AZURE_OPENAI_API_VERSION MUST be the literal "preview"
#                 (dated versions 400 with "API version not supported")
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com                          # [REQUIRED] chat
AZURE_OPENAI_API_KEY=<azure-openai-or-foundry-key>                                 # [REQUIRED] chat
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano                                               # [REQUIRED] chat deployment name
AZURE_OPENAI_API_VERSION=2025-04-01-preview                                        # [REQUIRED] see shapes above

# Optional pacing / retry (shared_pipeline_stages/llm_pacing.py)
LLM_MIN_INTERVAL_SEC=                                                            # [OPTIONAL] seconds between LLM calls; empty = default pacing
LLM_429_MAX_ATTEMPTS=                                                            # [OPTIONAL] max retries on HTTP 429


# -----------------------------------------------------------------------------
# BLOCK B — Mini / preferred Stage 7–8 LLM (falls back to BLOCK A if incomplete)
# Consumers: shared_pipeline_stages/stage_7/merge_runner.py,
#            shared_pipeline_stages/stage_8/linking_runner.py
# Rule: all four AZURE_MINI_* must be set or the runners use AZURE_OPENAI_*.
# -----------------------------------------------------------------------------
AZURE_MINI_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/responses?api-version=2025-04-01-preview  # [OPTIONAL] Stage 7/8 preferred
AZURE_MINI_OPENAI_API_KEY=<same-or-dedicated-key>                                                               # [OPTIONAL]
AZURE_MINI_OPENAI_DEPLOYMENT=gpt-5.4-nano                                                                       # [OPTIONAL]
AZURE_MINI_OPENAI_API_VERSION=2025-04-01-preview                                                                # [OPTIONAL]

# Stage 8 knobs
STAGE8_LLM_PAUSE_SECONDS=3                                                       # [OPTIONAL] pause between Stage 8 LLM calls (playbook_builder)
STAGE8_USE_CAPABILITY_TAG_CONSTRAINTS=0                                          # [OPTIONAL] "1" enables capability-tag constraints (link_scoring)


# -----------------------------------------------------------------------------
# BLOCK C — Azure Computer Vision (ONLY allowed vision provider in this repo)
# Consumers: operational Stage 1 training-video OCR;
#            incidence Stage 2 artifact gate + Stage 3 enrichment;
#            shared_pipeline_stages/azure_computer_vision.py
# Company policy: do not add local/VLM/other-vendor vision calls.
# Smoke: operational Stage 1 with a short video clip; incidence --stage2-artifact-gate azure_cv
# -----------------------------------------------------------------------------
AZURE_COMPUTER_VISION_ENDPOINT=https://<resource>.cognitiveservices.azure.com    # [REQUIRED] vision
AZURE_COMPUTER_VISION_KEY=<computer-vision-key>                                  # [REQUIRED] vision
AZURE_COMPUTER_VISION_API_VERSION=2023-10-01                                     # [OPTIONAL] default 2023-10-01
AZURE_COMPUTER_VISION_MIN_INTERVAL_SEC=3.5                                       # [OPTIONAL] free tier ~20/min; raise if upgraded

# Local OCR helper (training video builder) — not Azure
TESSERACT_CMD=                                                                   # [OPTIONAL] path to tesseract.exe if not on PATH
# LOCALAPPDATA is read from the OS; do not set unless debugging Windows paths.


# -----------------------------------------------------------------------------
# BLOCK D — Embeddings (shared Stages 6.5 + 10; keep separate from chat)
# Consumers: shared_pipeline_stages/stage_6_5/embedder.py
# Also accepted fallbacks when AZURE_EMBEDDINGS_* unset:
#   AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_API_KEY / AZURE_OPENAI_EMBEDDING_DEPLOYMENT
#   AZURE_OPENAI_API_VERSION (classic only)
# -----------------------------------------------------------------------------
AZURE_EMBEDDINGS_ENDPOINT=https://<embeddings-resource>.openai.azure.com         # [REQUIRED] Stage 6.5/10
AZURE_EMBEDDINGS_API_KEY=<embeddings-key>                                        # [REQUIRED] Stage 6.5/10
AZURE_EMBEDDINGS_DEPLOYMENT=text-embedding-3-small                               # [REQUIRED] must match publish model
AZURE_EMBEDDINGS_API_VERSION=2024-02-15-preview                                  # [OPTIONAL]
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small                       # [ALIAS] fallback deployment name


# -----------------------------------------------------------------------------
# BLOCK E — Blob canonical images (Stage 11 publish)
# Consumers: shared_pipeline_stages/stage_11/container_config.py
#            load_blob_image_settings()
# -----------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net  # [REQUIRED] Stage 11 images
AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net/               # [OPTIONAL] helpful for URL construction
AZURE_CANONICAL_IMAGES_CONTAINER=canonical-images                                # [OPTIONAL] default canonical-images


# -----------------------------------------------------------------------------
# BLOCK F — Cosmos cumulative publish (Stage 11) — publish container set
# Consumers: shared_pipeline_stages/stage_11/container_config.py
# Also accepted aliases: AZURE_COSMOS_ENDPOINT, AZURE_COSMOS_KEY,
#                        AZURE_COSMOS_DATABASE_NAME
# Smoke: Stage 11 publish dry-run / cosmos upload report under data/output
# -----------------------------------------------------------------------------
COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/                       # [REQUIRED] Stage 11 + Brain azure
COSMOS_KEY=<cosmos-primary-or-secondary-key>                                     # [REQUIRED] Stage 11 + Brain azure
COSMOS_DATABASE=optisweep_knowledge_phase0                                       # [REQUIRED] shared DB name

# Stage 11 container names (override defaults only if your account differs)
COSMOS_CONTAINER_RUNBOOKS=runbooks                                               # [OPTIONAL] default runbooks
COSMOS_CONTAINER_PLAYBOOKS_A=playbooks_prompt_a                                  # [OPTIONAL]
COSMOS_CONTAINER_PLAYBOOKS_B=playbooks_prompt_b                                  # [OPTIONAL]
COSMOS_CONTAINER_RELATIONSHIP_LINKS=relationship_links                           # [OPTIONAL]
COSMOS_CONTAINER_SOURCE_ARTIFACTS=publish_source_artifacts                       # [OPTIONAL]
COSMOS_CONTAINER_OPERATIONAL_CONTEXT=operational_context                         # [OPTIONAL]
COSMOS_CONTAINER_CANONICAL_IMAGES=publish_canonical_images                       # [OPTIONAL]
COSMOS_CONTAINER_GATE_PHRASE_TABLES=gate_phrase_tables                           # [OPTIONAL]


# -----------------------------------------------------------------------------
# BLOCK G — Brain Cosmos containers (SEPARATE set from Stage 11 publish)
# Consumers: providers/azure_cosmos_config.py, providers/azure_storage.py
# Shares COSMOS_ENDPOINT / COSMOS_KEY / COSMOS_DATABASE with Block F.
# Every COSMOS_CONTAINER_BRAIN_* is optional; defaults to the role name.
# Provision once:
#   python -m providers.scripts.provision_brain_cosmos_containers
# -----------------------------------------------------------------------------
COSMOS_CONTAINER_BRAIN_EVIDENCE=brain_evidence                                   # [OPTIONAL]
COSMOS_CONTAINER_BRAIN_ENTITIES=brain_entities                                   # [OPTIONAL]
COSMOS_CONTAINER_BRAIN_CLAIMS=brain_claims                                       # [OPTIONAL]
COSMOS_CONTAINER_BRAIN_RELATIONSHIPS=brain_relationships                         # [OPTIONAL]
COSMOS_CONTAINER_BRAIN_CAPABILITIES=brain_capabilities                           # [OPTIONAL]
COSMOS_CONTAINER_BRAIN_PROCEDURES=brain_procedures                               # [OPTIONAL]
COSMOS_CONTAINER_BRAIN_PLAYBOOKS=brain_playbooks                                 # [OPTIONAL]
COSMOS_CONTAINER_BRAIN_REVIEWS=brain_reviews                                     # [OPTIONAL]
COSMOS_CONTAINER_BRAIN_INGESTION_RUNS=brain_ingestion_runs                       # [OPTIONAL]
COSMOS_CONTAINER_BRAIN_EMBEDDINGS=brain_embeddings                               # [OPTIONAL]


# -----------------------------------------------------------------------------
# BLOCK H — Provider / storage backend selection (mcp_server/providers_config.py)
# Defaults shown. Company policy: LLM=azure_openai, vision=azure_cv.
# -----------------------------------------------------------------------------
OPTISWEEP_LLM_PROVIDER=azure_openai                                              # [OPTIONAL] default azure_openai
OPTISWEEP_VISION_PROVIDER=azure_cv                                               # [OPTIONAL] default azure_cv (only allowed)
OPTISWEEP_EMBEDDING_PROVIDER=azure_openai                                        # [OPTIONAL] default azure_openai
OPTISWEEP_STORAGE_BACKEND=local                                                  # [OPTIONAL] local | azure
# local  -> JSON under brain/data/local/
# azure  -> requires Blocks F+G Cosmos settings
BRAIN_INGESTION_ENABLED=1                                                        # [OPTIONAL] 1/true on (default); 0/false/no opts out


# -----------------------------------------------------------------------------
# BLOCK I — SharePoint intake + review outbox (OPTIONAL orchestration)
# Consumers: orchestration/intake/sharepoint.py
# Mode A: OneDrive-synced library path (recommended for local agents)
# Mode B: Microsoft Graph app registration
# -----------------------------------------------------------------------------
# Mode A
SHAREPOINT_SYNC_ROOT=C:\Users\<you>\Contoso\OptiSweep Ingestion - Documents      # [OPTIONAL] Mode A
# Expected under root: inbox/{incidents,manuals,videos}/  and  review/

# Mode B
SHAREPOINT_TENANT_ID=<directory-tenant-id>                                       # [OPTIONAL] Mode B
SHAREPOINT_CLIENT_ID=<app-client-id>                                             # [OPTIONAL] Mode B
SHAREPOINT_CLIENT_SECRET=<app-client-secret>                                     # [OPTIONAL] Mode B
SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/OptiSweep               # [OPTIONAL] Mode B
SHAREPOINT_LIBRARY=Documents                                                     # [OPTIONAL] Mode B
SHAREPOINT_INBOX_FOLDER=inbox                                                    # [OPTIONAL] Mode B
SHAREPOINT_REVIEW_FOLDER=review                                                  # [OPTIONAL] Mode B


# -----------------------------------------------------------------------------
# BLOCK J — Microsoft Graph / Teams chat probe (DEVELOPMENT ONLY)
# Consumers: connectors/microsoft_graph/auth.py
# Smoke: python scripts/test_teams_graph_connection.py
# Setup: connectors/microsoft_graph/README.md
# device_code mode: leave GRAPH_CLIENT_SECRET empty; app must Allow public
# client flows = Yes. Delegated: User.Read, Chat.Read, Files.Read
# -----------------------------------------------------------------------------
GRAPH_AUTH_MODE=device_code                                                      # [OPTIONAL] probe
GRAPH_TENANT_ID=<directory-tenant-id>                                            # [OPTIONAL] probe
GRAPH_CLIENT_ID=<application-client-id>                                          # [OPTIONAL] probe
GRAPH_CLIENT_SECRET=                                                             # [OPTIONAL] empty for device_code


# -----------------------------------------------------------------------------
# BLOCK K — Salesforce connectivity probe (DEVELOPMENT ONLY)
# Consumers: connectors/salesforce/auth.py
# Smoke: python scripts/test_salesforce_connection.py
# Local checks may use personal user+password+token; production should use a
# dedicated integration user + External Client App + OAuth client credentials.
# -----------------------------------------------------------------------------
SALESFORCE_USERNAME=<integration-or-dev-username>                                # [OPTIONAL] probe
SALESFORCE_PASSWORD=<password>                                                   # [OPTIONAL] probe
SALESFORCE_SECURITY_TOKEN=<security-token>                                       # [OPTIONAL] probe
SALESFORCE_LOGIN_URL=https://login.salesforce.com/services/Soap/u/59.0           # [OPTIONAL] prod default; sandbox: https://test.salesforce.com/services/Soap/u/59.0


# =============================================================================
# MINIMUM VIABLE SETS (for agents provisioning Azure)
# =============================================================================
# A) Run operational/incidence LLM stages only (no publish, local Brain):
#      Block A + Block C (+ Block D if running Stage 6.5/10)
#
# B) Full shared pipeline through Stage 11 publish:
#      Blocks A, B(optional), C, D, E, F  (+ G if Brain azure storage)
#
# C) Brain on Cosmos instead of local JSON:
#      Blocks F + G + OPTISWEEP_STORAGE_BACKEND=azure
#
# D) Phase 0 APP (separate repo / handoff package):
#      See app_handoff_package/config/feature_flags.env.example
#      (RETRIEVAL_BACKEND, USE_PLAYBOOK_ORCHESTRATION, PUBLISH_VERSION_ID, …)
# =============================================================================
