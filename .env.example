# Copy to .env and fill secrets. Never commit .env.
# Agents: prefer `.env.mock` (same keys, required/optional tags, consumers, MVP sets).

# --- Chat LLM (Stages 3-7; prefer gpt mini over DeepSeek for rate limits) ---
# Three endpoint shapes are supported (auto-detected by shared_pipeline_stages/llm_pacing.py):
#   1. Classic:      https://<resource>.openai.azure.com                          -> AZURE_OPENAI_API_VERSION = dated, e.g. 2024-10-21
#   2. Foundry proj:  https://<resource>.services.ai.azure.com/api/projects/<proj> -> AZURE_OPENAI_API_VERSION = dated, e.g. 2025-04-01-preview
#   3. Foundry v1:    https://<resource>.services.ai.azure.com/openai/v1/responses -> AZURE_OPENAI_API_VERSION must be the literal string "preview" (NOT a dated version — the /v1/ path segment carries the version; a dated value 400s with "API version not supported")
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Stage 8 linking prefers these when all four are set (falls back to AZURE_OPENAI_*)
AZURE_MINI_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/responses?api-version=2025-04-01-preview
AZURE_MINI_OPENAI_API_KEY=
AZURE_MINI_OPENAI_DEPLOYMENT=gpt-5.4-nano
AZURE_MINI_OPENAI_API_VERSION=2025-04-01-preview

# --- Azure Computer Vision (Image Analysis) ---
# Company policy: Azure Computer Vision must be the only vision model used
# anywhere in this repo; do not add local/VLM/other-vendor vision calls.
# Used by:
#   1. Operational Stage 1 (training-video slide OCR) - read feature only.
#   2. Incidence Stage 2 artifact gate (--stage2-artifact-gate azure_cv) and
#      Stage 3 artifact enrichment - caption,denseCaptions,tags,objects,read.
AZURE_COMPUTER_VISION_ENDPOINT=https://<resource>.cognitiveservices.azure.com
AZURE_COMPUTER_VISION_KEY=
AZURE_COMPUTER_VISION_API_VERSION=2023-10-01
# Free tier = 20 calls/min; default pacing is 3.5s/call (~17/min). Raise this
# if you upgrade tiers, lower it if you still hit 429s. Incidence Stage 2/3
# usage adds meaningfully more calls per case than Stage 1 OCR alone (one
# gate call per candidate image plus one describe call per kept artifact);
# size your tier/pacing accordingly for larger cases.
AZURE_COMPUTER_VISION_MIN_INTERVAL_SEC=3.5

# --- Embeddings (Stages 6.5 + 10). Keep separate from chat endpoint. ---
AZURE_EMBEDDINGS_ENDPOINT=https://<embeddings-resource>
AZURE_EMBEDDINGS_API_KEY=
AZURE_EMBEDDINGS_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDINGS_API_VERSION=2024-02-15-preview

# --- Blob canonical images (Stage 11) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net/
AZURE_CANONICAL_IMAGES_CONTAINER=canonical-images

# --- Cosmos cumulative publish (Stage 11) ---
COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DATABASE=optisweep_knowledge_phase0
COSMOS_CONTAINER_RUNBOOKS=runbooks
COSMOS_CONTAINER_PLAYBOOKS_A=playbooks_prompt_a
COSMOS_CONTAINER_PLAYBOOKS_B=playbooks_prompt_b
COSMOS_CONTAINER_RELATIONSHIP_LINKS=relationship_links
COSMOS_CONTAINER_SOURCE_ARTIFACTS=publish_source_artifacts
COSMOS_CONTAINER_OPERATIONAL_CONTEXT=operational_context
COSMOS_CONTAINER_CANONICAL_IMAGES=publish_canonical_images
COSMOS_CONTAINER_GATE_PHRASE_TABLES=gate_phrase_tables

# --- Brain's own Cosmos containers (providers/azure_storage.py) ---
# Same account/database as above (COSMOS_ENDPOINT/COSMOS_KEY/COSMOS_DATABASE
# are shared) -- these are a SEPARATE container set from Stage 11's publish
# containers above, never the same containers. Every COSMOS_CONTAINER_BRAIN_*
# var below is optional; each defaults to its own role name (e.g.
# brain_entities) if unset, so this whole block can normally stay unset.
# Provision the 10 containers once via:
#   python -m providers.scripts.provision_brain_cosmos_containers
# COSMOS_CONTAINER_BRAIN_EVIDENCE=brain_evidence
# COSMOS_CONTAINER_BRAIN_ENTITIES=brain_entities
# COSMOS_CONTAINER_BRAIN_CLAIMS=brain_claims
# COSMOS_CONTAINER_BRAIN_RELATIONSHIPS=brain_relationships
# COSMOS_CONTAINER_BRAIN_CAPABILITIES=brain_capabilities
# COSMOS_CONTAINER_BRAIN_PROCEDURES=brain_procedures
# COSMOS_CONTAINER_BRAIN_PLAYBOOKS=brain_playbooks
# COSMOS_CONTAINER_BRAIN_REVIEWS=brain_reviews
# COSMOS_CONTAINER_BRAIN_INGESTION_RUNS=brain_ingestion_runs
# COSMOS_CONTAINER_BRAIN_EMBEDDINGS=brain_embeddings

# --- Storage/provider backend selection (mcp_server/providers_config.py) ---
OPTISWEEP_LLM_PROVIDER=azure_openai
OPTISWEEP_VISION_PROVIDER=azure_cv
OPTISWEEP_EMBEDDING_PROVIDER=azure_openai
# OPTISWEEP_STORAGE_BACKEND=local        # default; local JSON under brain/data/local/
# OPTISWEEP_STORAGE_BACKEND=azure        # requires the Cosmos settings above
# BRAIN_INGESTION_ENABLED=1          # in-tandem pipeline-stage Brain hooks (default ON; set to 0/false/no to opt out)

# --- SharePoint intake + review outbox (optional) ---
# Mode A (recommended): OneDrive-synced SharePoint library path
# SHAREPOINT_SYNC_ROOT=C:\Users\<you>\Contoso\OptiSweep Ingestion - Documents
# Expected layout under that root:
#   inbox/{incidents,manuals,videos}/
#   review/
#
# Mode B: Microsoft Graph app registration
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/OptiSweep
# SHAREPOINT_LIBRARY=Documents
# SHAREPOINT_INBOX_FOLDER=inbox
# SHAREPOINT_REVIEW_FOLDER=review

# --- Microsoft Graph / Teams chat probe (DEVELOPMENT ONLY) ---
# Used by: python scripts/test_teams_graph_connection.py
# Setup steps: connectors/microsoft_graph/README.md
#
# Exact values for device-code mode:
#   GRAPH_AUTH_MODE=device_code
#   GRAPH_TENANT_ID=<Directory (tenant) ID>
#   GRAPH_CLIENT_ID=<Application (client) ID>
# Leave GRAPH_CLIENT_SECRET empty for device_code.
# App registration must Allow public client flows = Yes
# Delegated permissions: User.Read, Chat.Read, Files.Read
GRAPH_AUTH_MODE=device_code
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Salesforce connectivity probe (DEVELOPMENT ONLY) ---
# Used by: python scripts/test_salesforce_connection.py
# Personal username/password/security-token is for local API checks only.
# Production connector should use a dedicated integration user + External
# Client App + OAuth client credentials — never personal credentials.
# Production login (default if unset):
#   https://login.salesforce.com/services/Soap/u/59.0
# Sandbox login:
#   https://test.salesforce.com/services/Soap/u/59.0
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_LOGIN_URL=https://login.salesforce.com/services/Soap/u/59.0
